  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "Wasp 0.24 client on Vercel, server on Fly.io",
        "Operations, public API keys and PgBoss jobs (hourly stats, weekly market drift) live in the server",
        "OpenAI is called only with DFVA_MOCK=false"
      ]
    },
    {
      "dot": "emerald",
      "title": "Content pipeline",
      "items": [
        "reports/*.md and dfva/source/ are canonical; generated files are never hand-edited",
        "dfva:check fails CI on drift",
        "Handbook evidence is captured through a real browser, paced at one page per 20–30 s"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent-first",
      "items": [
        "dfva-mcp exposes get_assessment, query_assessments, get_report and more",
        "Agents consume assessments.json without visiting the site"
      ]
    }
  ]
