{
  "name": "dfva-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "DFVA batch pipeline validation and tooling",
  "scripts": {
    "dfva:gen": "npx tsx dfva-generate.ts",
    "test": "node --import tsx --test *.test.ts",
    "dfva:gen-v4": "npx tsx dfva-v4-schema-check.ts && npx tsx dfva-v4-gen.ts",
    "dfva:gen-content": "npx tsx dfva-content-generate.ts",
    "dfva:gen-assessments": "npx tsx dfva-build-assessments.ts",
    "dfva:v4-schema-check": "npx tsx dfva-v4-schema-check.ts",
    "dfva:v4-parity-check": "npx tsx dfva-v4-parity-check.ts",
    "dfva:check": "npx tsx dfva-check.ts && npx tsx check-report-format.ts && npx tsx dfva-v4-schema-check.ts && npx tsx dfva-v4-parity-check.ts && npx tsx dfva-content-check.ts && npx tsx dfva-registry-check.ts && npx tsx dfva-assessments-check.ts && npx tsx dfva-panela-coverage-check.ts && npx tsx dfva-reports-index-check.ts && npx tsx dfva-v4-distinctness-check.ts && npx tsx dfva-instrument-purity-check.ts && npx tsx dfva-v4-verify-evidence.ts --strict && npx tsx check-capture-duplicates.ts && python3 check-report-prose.py",
    "dfva:assessments-check": "npx tsx dfva-assessments-check.ts",
    "dfva:check-registry": "npx tsx dfva-registry-check.ts",
    "dfva:content-check": "npx tsx dfva-content-check.ts",
    "dfva:completeness": "npx tsx check-course-completeness.ts",
    "dfva:report-lint": "npx tsx check-report-format.ts",
    "dfva:deck": "python3 build-evidura-deck.py",
    "dfva:sync-skill": "cp ../dfva/dist/claude-skill/SKILL.md ~/.claude/skills/dfva/SKILL.md",
    "dfva:panela-coverage": "npx tsx dfva-panela-coverage-check.ts",
    "dfva:verify-evidence": "npx tsx dfva-v4-verify-evidence.ts",
    "dfva:capture-check": "npx tsx check-capture-provenance.ts",
    "dfva:capture-queue": "python3 build-capture-queue.py",
    "dfva:reports-index": "npx tsx dfva-reports-index-check.ts",
    "dfva:purity-check": "npx tsx dfva-instrument-purity-check.ts",
    "dfva:report-prose": "python3 check-report-prose.py",
    "dfva:latrobe-discover": "python3 latrobe-handbook-scrape.py --discover",
    "dfva:latrobe-scrape": "python3 latrobe-handbook-scrape.py --scrape",
    "dfva:monash-discover": "python3 monash-handbook-scrape.py --discover",
    "dfva:monash-scrape": "python3 monash-handbook-scrape.py --scrape",
    "dfva:unsw-discover": "python3 unsw-handbook-scrape.py --discover",
    "dfva:unsw-scrape": "python3 unsw-handbook-scrape.py --scrape",
    "dfva:anu-discover": "python3 anu-handbook-scrape.py --discover",
    "dfva:anu-scrape": "python3 anu-handbook-scrape.py --scrape",
    "dfva:uwa-discover": "python3 uwa-handbook-scrape.py --discover",
    "dfva:uwa-scrape": "python3 uwa-handbook-scrape.py --scrape",
    "dfva:adelaide-discover": "python3 adelaide-handbook-scrape.py --discover",
    "dfva:adelaide-scrape": "python3 adelaide-handbook-scrape.py --scrape",
    "dfva:usyd-discover": "python3 usyd-handbook-scrape.py --discover",
    "dfva:usyd-scrape": "python3 usyd-handbook-scrape.py --scrape",
    "dfva:uq-discover": "python3 uq-handbook-scrape.py --discover",
    "dfva:uq-scrape": "python3 uq-handbook-scrape.py --scrape",
    "dfva:go8-status": "python3 go8-handbook-status.py",
    "dfva:subjects-discover": "python3 national-subject-scrape.py --discover --institution all",
    "dfva:subjects-scrape": "python3 national-subject-scrape.py --scrape --wave 1 --workers 10",
    "dfva:subjects-status": "python3 national-subject-status.py",
    "dfva:distinctness": "npx tsx dfva-v4-distinctness-check.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
