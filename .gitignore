# Templates — local only, not for version control
templates/

# Dependencies
node_modules/
compass/app/node_modules/
compass/blog/node_modules/
compass/e2e-tests/node_modules/

# Build outputs (compass-static dist is committed for Pages deployment)
compass/app/.wasp/
compass/blog/dist/

# graphify — generated knowledge graph (regenerable via `graphify update`)
graphify-out/

# scratch — working data (JIR PDFs/markdown, ad-hoc analysis scripts), not for VCS
scratch/
**/__pycache__/

# Environment files
.env
.env.local
.env.*.local
compass/app/.env
compass/app/.env.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
screencapture-enterprise-services-group-github-io-DFVA-2026-05-14-16_01_31.png
docs/workflow-sop.md

# Claude Code — personal/local settings (keep out of the shared repo).
# Exception: rules/ and skills/ are shared conventions the pipeline depends on.
# CLAUDE.md tells every agent to read .claude/rules/; a fresh clone must get them.
.claude/*
!.claude/rules/
!.claude/skills/

# Hermes Agent — personal/local (keep out of the shared repo)
.hermes/

# codebase-memory tool — auto-regenerated agent-config boilerplate (wrong
# "<YOUR_APP_NAME>"-template content; reappears under compass/* on reinstall).
# NOTE: compass/app/CLAUDE.md is hand-written and tracked — do not ignore it.
compass/*/.clinerules
compass/*/.cursorrules
compass/*/.roomodes
compass/*/.windsurfrules
compass/*/CONVENTIONS.md
compass/*/.github/copilot-instructions.md
compass/mcp/CLAUDE.md
compass/e2e-tests/CLAUDE.md

# Handbook cache (on-demand fetches)
.handbook-cache/

# Scripts — intermediate outputs (not committed)
scripts/node_modules/
scripts/output/

# Archived session-log changelog (never tracked; local only)
docs/archive/claude-rules-changelog-*.md

# Office lock files
~$*

# v4 capture intermediates — the assembled scrapes/v4/<code>.txt extracts are
# the evidence the scores quote from; these dirs are just how they got built.
scrapes/v4/raw/
scrapes/v4/pages/
scrapes/v4/inbox/

# Ad-hoc scrape status logs — process detritus, rewritten each run
/go8-*.txt
/go8-*.log
/go8_*.txt
/output.txt
scraping/
